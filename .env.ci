# Plan 162 Stage Q: the variables docker-compose.yml interpolates, with the
# values CI uses for them.
#
# Production reads these from a `.env` that is not in git. CI needs the same
# keys so that the base file's own service definitions -- above all Flyway's
# command, placeholders and all -- can be executed rather than transcribed
# into a workflow step. Committing them is safe and deliberate: every value
# below is a throwaway credential for a database that lives for the length of
# one job on a runner nobody else can reach. Do not add a key here whose
# production value is a secret; the workflow passes real ones through
# `secrets.*`, one step at a time.
#
# Passed as `--env-file .env.ci` by both the workflow and the parity guard, so
# the two resolved documents differ only where docker-compose.ci.yml says.

# The application database. `cartracker`/`cartracker` is what every heavy job's
# TEST_DATABASE_URL already expects.
POSTGRES_PASSWORD=cartracker

# The roles V013 and its successors create, whose passwords Flyway sets through
# placeholders. TEST_VIEWER_DATABASE_URL uses ci_viewer; the Airflow metadata
# step connects as airflow_user with ci_airflow.
VIEWER_DB_PASSWORD=ci_viewer
SCRAPER_DB_PASSWORD=ci_scraper
DBT_DB_PASSWORD=ci_dbt
AIRFLOW_DB_PASSWORD=ci_airflow
AIRFLOW_APP_DB_PASSWORD=ci_airflow_app
METRICS_DB_PASSWORD=ci_metrics
AUTH_EMAIL_SALT=ci_salt
ADMIN_EMAIL=ci@example.com

# The object store. `cartracker`/`cartracker123` is what the lake fixtures and
# every MINIO_ROOT_* in the workflow already use.
MINIO_ROOT_USER=cartracker
MINIO_ROOT_PASSWORD=cartracker123
