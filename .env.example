# ── Postgres superuser (used by Flyway migrations and ops/admin service) ──────
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ── Scoped Postgres role passwords (Plan 65) ──────────────────────────────────
# Each service connects with a least-privilege role. Generate independently.
VIEWER_DB_PASSWORD=change_me
SCRAPER_DB_PASSWORD=change_me
DBT_DB_PASSWORD=change_me

# ── Google OAuth (Plan 65) ────────────────────────────────────────────────────
# Register at: console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://cartracker-scraper.duckdns.org/oauth2/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Cookie signing secret — must be exactly 16, 24, or 32 bytes (base64).
# Generate with: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_COOKIE_SECRET=change_me_32_byte_base64_string

# ── Authorization (Plan 82) ───────────────────────────────────────────────────
# DB-backed auth. Users are stored as SHA-256(AUTH_EMAIL_SALT || email) hashes.
# AUTH_EMAIL_SALT: random string kept secret; used when hashing emails in DB and at runtime.
# ADMIN_EMAIL: bootstraps the first admin row via Flyway (V009). Used once.
# TELEGRAM_CHAT_ID: optional; numeric chat ID for access-request notifications.
# Generate a salt: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_EMAIL_SALT=change_me_to_a_random_secret_string
ADMIN_EMAIL=your_email@gmail.com
TELEGRAM_CHAT_ID=

# ── Resend (email notifications) ─────────────────────────────────────────────
# Sign up at resend.com, verify cartracker.info domain, generate an API key.
RESEND_API_KEY=re_your_api_key_here

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=cartracker
MINIO_ROOT_PASSWORD=change_me

# ── Lake snapshot downloads (Plan 120 Gate F) ─────────────────────────────────
# Bearer tokens accepted by /admin/snapshots/adaptive-refresh/* on ops. With
# both variables below empty the routes are disabled entirely (503).
#
# One entry per caller, `name:scope:token`, comma separated. The name appears in
# the access log so you can tell which caller it was; the token never does.
# Giving each caller its own entry is what makes revocation targeted — drop one
# entry, redeploy ops, and only that caller is out.
#
# Scopes: `read` (every route here today) and `write` (reserved). `write` grants
# `read` as well. The field exists before any route requires it because changing
# a credential format after CI depends on it means migrating a live caller.
#
# A token may contain colons but NOT a comma. Malformed entries are logged by
# position and ignored rather than taking the router down.
#
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SNAPSHOT_DOWNLOAD_TOKENS=ci:read:change_me,local:read:change_me_differently

# Pre-Plan-162 single unnamed token, still accepted so an existing deployment
# keeps working across the upgrade. It behaves as `legacy:read:<value>`. Retire
# it once every caller has a named entry above.
SNAPSHOT_DOWNLOAD_TOKEN=

# ── Challenge solver ──────────────────────────────────────────────────────────
# Three facts that are easy to conflate, so they are stated separately:
#
#   1. `trawl` is the live solver. It has been the production scrape path
#      since 2026-07-06; the `flaresolverr` container has served zero requests
#      since 2026-07-07 and is retained deliberately (docker-compose.yml:174)
#      so health coverage never exempts a service believed unused.
#   2. The variable kept its original name. There is no TRAWL_URL --
#      FLARESOLVERR_URL is what the scraper reads, and renaming it is a
#      migration, not a rename.
#   3. The protocol really is FlareSolverr's. cf_session.py POSTs
#      {"cmd": "request.get"} to ${FLARESOLVERR_URL}/v1, which `trawl`
#      implements. The name is accurate about the wire; only the container it
#      points at below is not.
#
# KNOWN STALE: the FLARESOLVERR_URL default below still names the vestigial
# container, and docker-compose.yml:267 carries the identical fallback.
# Production overrides both -- its .env sets http://trawl:8191 -- so this is a
# fresh-clone defect, not a production one. Flipping the defaults is Plan 167
# Stage 1; it is left alone here on purpose, because `trawl` is profile-gated
# and a default that names a container `up -d` does not start is its own
# decision (Plan 167 Stage 2).
#
# To run the live path locally:
#   docker compose --profile trawl up -d redis-trawl trawl
#   FLARESOLVERR_URL=http://trawl:8191   # then restart scraper

# Image pin for the vestigial flaresolverr container.
# Avoid :latest; browser upgrades can invalidate cached credential replay.
FLARESOLVERR_IMAGE=ghcr.io/flaresolverr/flaresolverr:v3.4.6
FLARESOLVERR_URL=http://flaresolverr:8191

# Leave TRAWL_IMAGE unset: docker-compose.yml carries the reviewed digest pin
# (Plan 136 Stage 3b). Set it only to roll back, and prefer a digest to a tag.
# TRAWL_IMAGE=ghcr.io/germondai/trawl@sha256:86b1fdf26cfeebd996eeedaeb774002434f4cf8d02e5486f8a8173373c4d6e9b
TRAWL_BROWSER_POOL_SIZE=2
TRAWL_BROWSER_ACQUIRE_TIMEOUT_MS=30000
TRAWL_SESSION_TTL_SECONDS=3600
TRAWL_BROWSER_RECYCLE_AFTER_CONTEXTS=8
TRAWL_BROWSER_CONTENT_PROCESSES=2

# ── SRP origin (Plan 162 Stage 8) ────────────────────────────────────────────
# Leave SCRAPER_RESULTS_BASE_URL unset. Production takes the default in
# scrape_results.py, and unset is the only value that cannot be wrong.
#
# It exists because `scrape_results` composes its URL from this base rather
# than taking one from its caller, the way `scrape_detail` takes `payload.url`.
# That made the SRP fetch path unreachable by any test, which was half of G8.
# `tests/integration/scraper/` sets it to a loopback origin and serves a
# recorded page; nothing else ever should.
#
# **Setting this also switches off the human-cadence pacing**, and that is why
# it is documented rather than deployed. `human_delay` sleeps 13-35s before
# page 1 (up to ~80s when its distraction branch fires) to look human to
# cars.com, and `scrape_results.PACING_APPLIES` exempts loopback origins so CI
# does not wait for it. A value pointing at 127.0.0.1 or localhost in a
# production .env would therefore scrape un-paced and look perfectly healthy
# until the site noticed -- the hardest kind of outage to attribute. An origin
# that is neither is still paced, so a second real scrape target needs no
# change here.
# SCRAPER_RESULTS_BASE_URL=https://www.cars.com/shopping/results/

# Detail scrape throttles
# Lower values are safer during Cars.com 403/Cloudflare pressure.
DETAIL_BATCH_SIZE=100
DETAIL_MAX_WORKERS=1
DETAIL_REQUEST_TIMEOUT_S=90
SCRAPER_DETAIL_MAX_WORKERS=1
SCRAPER_DETAIL_TIMEOUT_S=90

# ── Telegram bot (alerting and notifications) ────────────────────────────────
# Bot token used by Grafana contact points, Airflow DAG failure callbacks, the
# redeploy script, and access-request notifications from ops. Pairs with
# TELEGRAM_CHAT_ID above.
TELEGRAM_API=your-telegram-bot-token

# ── Internal API key (ops service) ───────────────────────────────────────────
FASTAPI_ADMIN_KEY=change_me

# ── Lakekeeper REST catalog (Plan 112 Gate A1) ───────────────────────────────
# Standalone stack: docker-compose.lakehouse.yml -p cartracker-lakehouse.
# Isolated from production Postgres -- lakekeeper-postgres is its own
# container/volume. See docs/runbook_lakehouse.md.
LAKEKEEPER_IMAGE=quay.io/lakekeeper/catalog:v0.13.1
# Use a URL-safe/hex value, not arbitrary text -- this is substituted
# directly into lakekeeper-postgres's DSN URL, so symbols like @ : / # break
# DSN parsing (learned during VM A1 verification).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
LAKEKEEPER_DB_PASSWORD=change_me
# 16-byte (or longer) secret used by Lakekeeper to encrypt secrets at rest.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
LAKEKEEPER_PG_ENCRYPTION_KEY=change_me
# Catalog REST endpoint: container-DNS on the VM/local (http://lakekeeper:8181/catalog),
# or http://localhost:18181/catalog against the CI override's published port.
LAKEKEEPER_CATALOG_URI=http://lakekeeper:8181/catalog

# ── MLflow experiment provenance (Plan 112 Gate B) ───────────────────────────
# Standalone stack: docker-compose.mlflow.yml -p cartracker-mlflow.
# This first Gate B chunk is a provenance bridge only -- it uses an isolated
# SQLite backend store (no production Postgres, no Flyway migration) and an
# isolated MinIO artifact prefix (s3://${MINIO_BUCKET}/mlflow/artifacts/). No
# new secret is required: artifact access reuses MINIO_ROOT_USER/PASSWORD.
# See docs/runbook_lakehouse.md ("Gate B provenance smoke").
#
# Where scripts/log_lakehouse_experiment_provenance.py logs runs. Defaults to
# a local file store (file:./.cache/mlruns) when unset, so a bare host needs
# no server. Point at the standalone server for the browsable UI:
#   MLFLOW_TRACKING_URI=http://localhost:15000
MLFLOW_TRACKING_URI=file:./.cache/mlruns
# Environment tag recorded on each provenance run: local | vm | ci.
PROVENANCE_ENV=local
