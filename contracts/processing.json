  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "description": "Endpoint that serves Prometheus metrics.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/process/artifact/{artifact_id}": {
      "post": {
        "description": "Reprocess a single artifact by ID.\n\nClaims the artifact (sets status='processing'), processes it,\nthen marks final status. Returns the processing result.",
        "operationId": "process_single_artifact_process_artifact__artifact_id__post",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "title": "Artifact Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Process Single Artifact Process Artifact  Artifact Id  Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No artifact with that id is queued."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Process Single Artifact"
      }
    },
    "/process/batch": {
      "post": {
        "description": "Claim and process a batch of pending/retry artifacts.\n\nResponse shape matches Plan 71 Airflow DAG expectations:\n  srp_count, detail_count, retry_count, skip_count, silver_write_failures,\n  status_write_failures",
        "operationId": "process_batch_process_batch_post",
        "parameters": [
          {
            "in": "query",
            "name": "batch_size",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 2500,
              "minimum": 1,
              "title": "Batch Size",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "artifact_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Artifact Type"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Process Batch Process Batch Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "The queue could not be read; no artifacts were claimed."
          }
        },
        "summary": "Process Batch"
      }
    },
    "/ready": {
      "get": {
        "description": "Drain signal for Plan 92 / Airflow.\n\nReturns ready=true when no batch is currently executing.\nAirflow sensors poll this before closing a DAG run.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency this service needs is not reachable."
          }
        },
        "summary": "Ready"
      }
    }
  }
}
