  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/dbt/build": {
      "post": {
        "description": "Trigger a dbt build against the DuckDB analytics target.\n\nPayload options (all optional):\n  - select:       list of dbt selector tokens; omit to build all models\n  - exclude:      list of selector tokens to exclude\n  - full_refresh: bool (default False)\n  - fail_fast:    bool (default True)\n\nReturns 409 if a build is already in progress.\nReturns 500 if dbt exits non-zero.",
        "operationId": "dbt_build_dbt_build_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "default": {},
                "title": "Payload",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Dbt Build Dbt Build Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "The requested selection is not usable."
          },
          "409": {
            "description": "A dbt build is already in progress."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "description": "dbt exited non-zero; the summary is the detail."
          }
        },
        "summary": "Dbt Build"
      }
    },
    "/dbt/docs/generate": {
      "post": {
        "description": "Run dbt deps + dbt docs generate and return ok/stdout/stderr.",
        "operationId": "dbt_docs_generate_dbt_docs_generate_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Dbt Docs Generate Dbt Docs Generate Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "description": "dbt exited non-zero; the summary is the detail."
          }
        },
        "summary": "Dbt Docs Generate"
      }
    },
    "/dbt/docs/status": {
      "get": {
        "description": "Check whether dbt docs have been generated (target/index.html exists).",
        "operationId": "get_docs_status_dbt_docs_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Docs Status Dbt Docs Status Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Docs Status"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency this service needs is not reachable."
          }
        },
        "summary": "Ready"
      }
    }
  }
}
