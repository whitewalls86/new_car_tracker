  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "description": "Endpoint that serves Prometheus metrics.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/ready": {
      "get": {
        "description": "Drain endpoint. Returns 503 while jobs are running or queued so that\nmonitoring and Airflow sensors get a clear not-ready signal via status code.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency this service needs is not reachable."
          }
        },
        "summary": "Ready"
      }
    },
    "/scrape_detail": {
      "post": {
        "operationId": "scrape_detail_scrape_detail_post",
        "parameters": [
          {
            "in": "query",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Payload",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Scrape Detail Scrape Detail Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Scrape Detail"
      }
    },
    "/scrape_detail/batch": {
      "post": {
        "description": "Queues an async detail-batch scrape job. Returns job_id immediately.\npayload.listings: [{listing_id, vin?, url?}, ...]\npayload.max_workers: optional int (default SCRAPER_DETAIL_MAX_WORKERS or 1)\npayload.timeout_s: optional per-request timeout (default SCRAPER_DETAIL_TIMEOUT_S or 90)\nPoll GET /scrape_results/jobs/completed to retrieve results.",
        "operationId": "scrape_detail_batch_endpoint_scrape_detail_batch_post",
        "parameters": [
          {
            "in": "query",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Payload",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Scrape Detail Batch Endpoint Scrape Detail Batch Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "The batch request names no usable listings."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Scrape Detail Batch Endpoint"
      }
    },
    "/scrape_results": {
      "post": {
        "description": "Queues an async SRP scrape job. Returns job_id immediately.\nThe scrape runs in a background thread; poll /scrape_results/jobs/completed\nto retrieve results.",
        "operationId": "run_scrape_results_scrape_results_post",
        "parameters": [
          {
            "in": "query",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "search_key",
            "required": true,
            "schema": {
              "title": "Search Key",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "required": true,
            "schema": {
              "title": "Scope",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Payload",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Run Scrape Results Scrape Results Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Scrape Results"
      }
    },
    "/scrape_results/jobs": {
      "get": {
        "description": "Lists all in-memory jobs (for debugging/dashboard).",
        "operationId": "list_all_jobs_scrape_results_jobs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List All Jobs Scrape Results Jobs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List All Jobs"
      }
    },
    "/scrape_results/jobs/completed": {
      "get": {
        "description": "Returns all completed or failed jobs. Failed jobs have no artifacts but\nare included so the Job Poller can clear them from memory and mark them in DB.",
        "operationId": "get_completed_jobs_scrape_results_jobs_completed_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Get Completed Jobs Scrape Results Jobs Completed Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Completed Jobs"
      }
    },
    "/scrape_results/jobs/{job_id}/fetched": {
      "post": {
        "description": "Marks a job as fetched and removes it from memory.",
        "operationId": "mark_job_fetched_scrape_results_jobs__job_id__fetched_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Mark Job Fetched Scrape Results Jobs  Job Id  Fetched Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such job, or it was already fetched."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mark Job Fetched"
      }
    }
  }
}
