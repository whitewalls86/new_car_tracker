{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "``GET /health`` -- process liveness, never dependency health.\n\nThe route's own docstring records why it stays shallow: probing Docker from\nhere would make this container's health a function of the proxy's.",
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "OneoffProcess": {
        "description": "One running Compose one-off, as drain evidence.\n\nEvery field is read straight off Docker's inspect payload and every one of\nthem can be absent there, which is why all three are optional. The\naggregator that consumes this indexes ``service`` and would raise on a\nmissing key -- that is its fail-closed behaviour and it is intended.",
        "properties": {
          "container_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Container Id"
          },
          "service": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          }
        },
        "title": "OneoffProcess",
        "type": "object"
      },
      "OneoffProcessesResponse": {
        "description": "``GET /oneoff-processes`` -- live execution evidence for drain.",
        "properties": {
          "active_processes": {
            "title": "Active Processes",
            "type": "integer"
          },
          "known": {
            "const": true,
            "title": "Known",
            "type": "boolean"
          },
          "processes": {
            "items": {
              "$ref": "#/components/schemas/OneoffProcess"
            },
            "title": "Processes",
            "type": "array"
          }
        },
        "required": [
          "known",
          "active_processes",
          "processes"
        ],
        "title": "OneoffProcessesResponse",
        "type": "object"
      },
      "ProjectStatusResponse": {
        "description": "``GET /project-status/{project}`` -- sibling-project activity.",
        "properties": {
          "known": {
            "const": true,
            "title": "Known",
            "type": "boolean"
          },
          "project": {
            "title": "Project",
            "type": "string"
          },
          "services": {
            "items": {
              "type": "string"
            },
            "title": "Services",
            "type": "array"
          }
        },
        "required": [
          "known",
          "project",
          "services"
        ],
        "title": "ProjectStatusResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Deliberately shallow: process liveness, never dependency health.\n\nProbing Docker from here would make this container's own health a function\nof the proxy's, and a cascading healthcheck is a worse signal than none.\nThe exporter's real liveness is `up{job=\"container-health\"}` -- if the\nDocker read fails, /metrics returns 500 and `ct-service-down` fires.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/oneoff-processes": {
      "get": {
        "description": "Expose read-only live execution evidence for Plan 142 drain aggregation.",
        "operationId": "active_oneoff_processes_oneoff_processes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OneoffProcessesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Active Oneoff Processes"
      }
    },
    "/project-status/{project}": {
      "get": {
        "description": "Read sibling-project activity for Plan 142's auxiliary release gate.",
        "operationId": "project_status_project_status__project__get",
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "title": "Project",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Project Status"
      }
    }
  }
}
