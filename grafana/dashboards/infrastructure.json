{
  "id": null,
  "uid": "cartracker-infrastructure",
  "title": "Infrastructure",
  "tags": ["cartracker", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "1m",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Host CPU Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))",
          "legendFormat": "CPU used"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 2,
      "title": "Host Memory Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "Memory used"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 3,
      "title": "Disk I/O (bytes/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(node_disk_read_bytes_total[2m])",
          "legendFormat": "Read {{device}}"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(node_disk_written_bytes_total[2m])",
          "legendFormat": "Write {{device}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 4,
      "title": "Postgres Active Connections by State",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "pg_stat_activity_count{state!=\"\"}",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "Postgres Transaction Rate (commits/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(pg_stat_database_xact_commit{datname=\"cartracker\"}[2m])",
          "legendFormat": "Commits/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 6,
      "title": "MinIO Logical Object Bytes",
      "description": "Sum of object payload sizes in the bucket. This is NOT disk usage -- it excludes the per-object storage floor and every non-MinIO volume sharing /mnt/data. Compare against the physical panel below.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "minio_bucket_usage_total_bytes",
          "legendFormat": "{{bucket}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 7,
      "title": "MinIO Request Rate (by API type)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(minio_s3_requests_total[2m])",
          "legendFormat": "{{api_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 8,
      "title": "MinIO Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(minio_s3_requests_errors_total[2m])",
          "legendFormat": "Errors/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 9,
      "title": "Filesystem Used %",
      "description": "Both volumes. Selector matches ct-disk-space-warning / ct-disk-space-critical exactly, so what you see here is what those alerts evaluate.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "1 - node_filesystem_avail_bytes{fstype!=\"tmpfs\",mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\",mountpoint!~\"/boot.*\"}",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Inode Used %",
      "description": "Inodes bind before bytes when the bucket is full of small objects -- each MinIO object costs 2. Exhaustion presents as ENOSPC with free space still on the disk. Selector matches ct-inode-warning / ct-inode-critical.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "1 - node_filesystem_files_free{fstype!=\"tmpfs\",mountpoint!~\"/boot.*\"} / node_filesystem_files{fstype!=\"tmpfs\",mountpoint!~\"/boot.*\"}",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "MinIO Logical vs Mount Physical",
      "description": "The divergence is the point. Logical counts object payloads; physical is everything actually consumed on /mnt/data, which includes MinIO's per-object floor plus Postgres, Loki, Prometheus and the Airflow logs.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(minio_bucket_usage_total_bytes)",
          "legendFormat": "MinIO logical"
        },
        {
          "datasource": "Prometheus",
          "expr": "node_filesystem_size_bytes{mountpoint=\"/mnt/data\"} - node_filesystem_avail_bytes{mountpoint=\"/mnt/data\"}",
          "legendFormat": "/mnt/data physical"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 12,
      "title": "Storage Amplification Ratio",
      "description": "Mount physical / MinIO logical. This is a mount-level ratio, so it folds in the non-MinIO volumes (~15 GiB) and reads high; the trend is what matters. Stage 4's per-volume metric will give the MinIO-only figure.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 40 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(node_filesystem_size_bytes{mountpoint=\"/mnt/data\"} - node_filesystem_avail_bytes{mountpoint=\"/mnt/data\"}) / sum(minio_bucket_usage_total_bytes)",
          "legendFormat": "physical / logical"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2 } }
    },
    {
      "id": 13,
      "title": "Mean Object Size",
      "description": "Denominator is minio_bucket_usage_object_total, chosen deliberately: it is the exact sum of MinIO's mutually-exclusive size buckets. Do not substitute sum(minio_bucket_objects_size_distribution) -- that series carries two overlapping bucket schemes and double-counts the 1 KB - 1 MB range. Falling mean = rising per-object tax; this is the leading indicator for whether Plan 131's packing is earning its keep.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 40 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "minio_bucket_usage_total_bytes / minio_bucket_usage_object_total",
          "legendFormat": "{{bucket}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 14,
      "title": "What's Filling The Disks",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "panels": []
    },
    {
      "id": 15,
      "title": "Root Disk by Path",
      "description": "Fixed watchlist, measured daily by the disk_usage DAG. Stacked because the question is always 'which band grew'. The total should reconcile roughly with the / line on Filesystem Used % -- roughly, because the watchlist covers most of the disk, not all of it.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 49 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_path_bytes{disk=\"root\"}",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 40, "stacking": { "mode": "normal" }, "showPoints": "never" }
        }
      }
    },
    {
      "id": 16,
      "title": "/mnt/data by Docker Volume",
      "description": "cartracker_parquet_data (MinIO, ~4M inodes) and cartracker_airflow_logs (~1.2M) are walked weekly, not daily -- their lines are steps, and cartracker_disk_usage_measured_timestamp_seconds says when each was last actually walked. Tier membership follows inode count, not size on disk: du costs O(inodes). Every other volume here is measured on every run.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 49 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_volume_bytes",
          "legendFormat": "{{volume}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 40, "stacking": { "mode": "normal" }, "showPoints": "never" }
        }
      }
    },
    {
      "id": 17,
      "title": "Biggest Consumers (current)",
      "description": "Both disks in one table, largest first. This is the panel that answers 'what is filling this disk' without an SSH session.",
      "type": "table",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 58 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "topk(10, cartracker_path_bytes or cartracker_volume_bytes)",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 18,
      "title": "Measurement Age",
      "description": "How long ago each series was actually walked. The MinIO volume should sit under 7 days; everything else under 1. A line climbing without resetting means the disk_usage DAG has stopped running and the gauges above are frozen at their last value.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 58 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "time() - cartracker_disk_usage_measured_timestamp_seconds",
          "legendFormat": "{{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 691200 },
              { "color": "red", "value": 1209600 }
            ]
          }
        }
      }
    }
  ]
}
