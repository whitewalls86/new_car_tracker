{
  "id": null,
  "uid": "cartracker-logs",
  "title": "Logs",
  "tags": [
    "logs",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "All Service Logs",
      "type": "logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "cartracker-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cartracker-loki"
          },
          "expr": "{service=~\".+\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      }
    },
    {
      "id": 2,
      "title": "Error / Warning / Critical Logs",
      "type": "logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "cartracker-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cartracker-loki"
          },
          "expr": "{service=~\".+\", level=~\"WARNING|ERROR|CRITICAL\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      }
    },
    {
      "id": 3,
      "title": "Log Volume by Service / Source / Level",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "cartracker-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cartracker-loki"
          },
          "expr": "sum by (service, source, level) (count_over_time({service=~\".+\"} [5m]))",
          "legendFormat": "{{service}} / {{source}} / {{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Unclassified Log Lines (5m, expected 0)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cartracker-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cartracker-prometheus"
          },
          "expr": "sum(increase(promtail_dropped_lines_total{reason=\"application_file_unclassified\"}[5m])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "description": "Application log records Promtail could not classify, counted where they are actually dropped. A Loki query cannot see these: the drop stage removes the line before it is stored, so the same panel read as a Loki count of level=\"\" was 0 by construction."
    },
    {
      "id": 5,
      "title": "Promtail Drops by Reason (5m)",
      "description": "Not every drop is a fault: airflow_non_actionable_control_plane and oauth2_successful_auth_subrequest are the retention policy working. This panel exists so each reason is countable and a shift in the mix is visible.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cartracker-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cartracker-prometheus"
          },
          "expr": "sum by (reason) (increase(promtail_dropped_lines_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
