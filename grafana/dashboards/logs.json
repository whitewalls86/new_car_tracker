{
  "id": null,
  "uid": "cartracker-logs",
  "title": "Logs",
  "tags": ["logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "All Service Logs",
      "type": "logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "cartracker-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cartracker-loki"
          },
          "expr": "{service=~\".+\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      }
    },
    {
      "id": 2,
      "title": "Error / Warning / Critical Logs",
      "type": "logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "cartracker-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cartracker-loki"
          },
          "expr": "{service=~\".+\", level=~\"WARNING|ERROR|CRITICAL\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      }
    },
    {
      "id": 3,
      "title": "Log Volume by Service / Source / Level",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "cartracker-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cartracker-loki"
          },
          "expr": "sum by (service, source, level) (count_over_time({service=~\".+\"} [5m]))",
          "legendFormat": "{{service}} / {{source}} / {{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Log Contract Violations (5m, expected 0)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "cartracker-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cartracker-loki"
          },
          "expr": "(sum(count_over_time({service=~\".+\", source=\"\"} [5m])) or vector(0)) + (sum(count_over_time({service=~\"ops|scraper|processing|dbt_runner|archiver|pack-worker|airflow-(apiserver|scheduler|dag-processor)|oauth2-proxy\", level=\"\"} [5m])) or vector(0))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    }
  ]
}
