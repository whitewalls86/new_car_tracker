{
  "id": null,
  "uid": "cartracker-pipeline-health",
  "title": "Pipeline Health",
  "tags": ["cartracker", "airflow"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Task Successes (total, 24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(airflow_ti_successes[24h])",
          "legendFormat": "Successes"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" }, "unit": "short" } }
    },
    {
      "id": 2,
      "title": "Task Failures (total, 24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(airflow_ti_failures[24h])",
          "legendFormat": "Failures"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "short" },
        "overrides": [{ "matcher": { "id": "byName", "options": "Failures" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }] }]
      }
    },
    {
      "id": 3,
      "title": "Scheduler Tasks Running",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "airflow_scheduler_tasks_running",
          "legendFormat": "Running"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "title": "Pool Open Slots",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "airflow_pool_open_slots",
          "legendFormat": "Open slots"
        }
      ],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "DAG Run Duration (success) by DAG",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "airflow_dagrun_duration_success",
          "legendFormat": "{{dag_id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "DAG Scheduling Delay by DAG",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "airflow_dagrun_schedule_delay",
          "legendFormat": "{{dag_id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "title": "Task Success Rate (global, 1h window)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(airflow_ti_successes[1h]) / (increase(airflow_ti_successes[1h]) + increase(airflow_ti_failures[1h]) + 0.001)",
          "legendFormat": "Success rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 8,
      "title": "DAG Run Duration (failed) by DAG",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "airflow_dagrun_duration_failed",
          "legendFormat": "{{dag_id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "title": "Observation Count (last hour)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 20 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_observation_count_last_hour{job=\"dbt_runner\"}",
          "legendFormat": "Observations"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 10,
      "title": "Artifact Count (last hour)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 20 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_artifact_count_last_hour{job=\"dbt_runner\"}",
          "legendFormat": "Artifacts"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 11,
      "title": "Block Events (last hour)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 20 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_block_events_last_hour{job=\"dbt_runner\"}",
          "legendFormat": "Block Events"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] } } }
    },
    {
      "id": 12,
      "title": "VIN Extraction Yield (last day)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_extraction_yield_last_day{job=\"dbt_runner\"}",
          "legendFormat": "Yield %"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 85 }, { "color": "green", "value": 90 }] } } }
    },
    {
      "id": 13,
      "title": "Stale Listings %",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_stale_listings_pct{job=\"dbt_runner\"}",
          "legendFormat": "Stale %"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 15 }, { "color": "red", "value": 25 }] } } }
    },
    {
      "id": 14,
      "title": "403 Cooldown Backlog (1-4 attempts)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_cooldown_backlog{job=\"dbt_runner\"}",
          "legendFormat": "In queue"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 3000 }] } } }
    },
    {
      "id": 15,
      "title": "403 Permanently Blocked (5+ attempts)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_cooldown_permanent{job=\"dbt_runner\"}",
          "legendFormat": "Blocked"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 2000 }] } } }
    },
    {
      "id": 16,
      "title": "Solver Outcomes (rate)",
      "description": "Plan 136 Stage 2. Scraper-owned, so it does not pass through dbt. `challenge` is the one to watch: it means the solver reported status=ok and handed back an interstitial, which is what `trawl` did for eight hours on 2026-08-14 while its own healthcheck stayed green. Healthy volume is low by design -- CF credentials cache for 25 minutes, so a working system bootstraps roughly 2.4 times an hour. A sustained rise in total volume is itself a failure signature: the error path never caches, so a refusing solver gets re-asked on every fetch.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (outcome) (rate(cartracker_solver_requests_total{job=\"scraper\"}[15m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    },
    {
      "id": 17,
      "title": "Detail Fetch Outcomes (rate)",
      "description": "Plan 136 Stage 2. The fast half of the liveness signal: `scrape_detail_pages` runs */15 with a batch of 100, so this is dense enough to show a throughput collapse within one batch. This is also the panel that answers open question 2 -- whether the solver's success rate decays gradually or falls off a cliff -- which is what chooses Stage 3's recycle interval. Read it before picking one.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (outcome) (rate(cartracker_detail_fetch_total{job=\"scraper\"}[15m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    },
    {
      "id": 18,
      "title": "403 Cooldown Funnel (rolling 7d)",
      "description": "How many detail scrapes entered each exponential-backoff bucket during the latest 168 hourly buckets. Derived from the durable ops_normalized/blocked_cooldown_events Parquet history. This is observability only: no alert is attached.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cartracker_cooldown_entries_7d_attempt_1{job=\"dbt_runner\"}",
          "legendFormat": "attempt 1"
        },
        {
          "datasource": "Prometheus",
          "expr": "cartracker_cooldown_entries_7d_attempt_2{job=\"dbt_runner\"}",
          "legendFormat": "attempt 2"
        },
        {
          "datasource": "Prometheus",
          "expr": "cartracker_cooldown_entries_7d_attempt_3_4{job=\"dbt_runner\"}",
          "legendFormat": "attempts 3-4"
        },
        {
          "datasource": "Prometheus",
          "expr": "cartracker_cooldown_entries_7d_attempt_5_10{job=\"dbt_runner\"}",
          "legendFormat": "attempts 5-10"
        },
        {
          "datasource": "Prometheus",
          "expr": "cartracker_cooldown_entries_7d_attempt_11_plus{job=\"dbt_runner\"}",
          "legendFormat": "attempts 11+"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    }
  ]
}
