select
    artifact_id,
    listing_id,
    source,
    listing_state,
    fetched_at,
    written_at,
    vin,
    vin17,
    price,
    make,
    model,
    vehicle_trim,
    model_year,
    mileage,
    msrp,
    stock_type,
    fuel_type,
    body_style,
    dealer_name,
    dealer_zip,
    dealer_city,
    dealer_state,
    customer_id,
    canonical_detail_url,
    financing_type,
    seller_zip,
    seller_customer_id,
    page_number,
    position_on_page,
    trid,
    isa_context,
    body,
    condition
